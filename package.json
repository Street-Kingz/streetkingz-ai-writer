{
  "name": "streetkingz-ai-writer",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "extract:product": "node scripts/extractProduct.js",
    "evidence:product": "node scripts/buildEvidence.js",
    "evidence:dataforseo": "node scripts/buildKeywordIdeasEvidence.js",
    "evidence:serp": "node scripts/buildSerpEvidence.js",
    "evidence:search-console": "node scripts/buildSearchConsoleEvidence.js",
    "auth:search-console": "node --env-file=.env scripts/authoriseSearchConsole.js",
    "research:aggregate": "node scripts/buildResearchState.js",
    "research:page-inventory": "node scripts/buildPageInventory.js",
    "cornerstone:fixture": "node scripts/buildCornerstoneFixture.js",
    "cornerstone:strategy": "node --env-file=.env scripts/runCornerstoneStrategy.js",
    "editorial:page-plan": "node scripts/buildEditorialPagePlan.js",
    "editorial:draft": "node --env-file=.env scripts/runControlledEditorialDraft.js",
    "editorial:founder-revision": "node --env-file=.env scripts/runFounderEditorialRevision.js",
    "editorial:accept-corrected-revision": "node scripts/acceptCorrectedFounderRevision.js",
    "voice:street-kingz-profile": "node scripts/buildStreetKingzVoiceProfile.js",
    "voice:import-street-kingz-corpus": "node scripts/importStreetKingzVoiceCorpus.js",
    "voice:approve-street-kingz-profile": "node scripts/approveStreetKingzVoiceProfile.js",
    "voice:prepare-street-kingz-transformation": "node scripts/prepareStreetKingzVoiceTransformation.js",
    "voice:prepare-street-kingz-transformation-replacement": "node scripts/prepareStreetKingzVoiceTransformationReplacement.js",
    "voice:transform-street-kingz": "node --env-file=.env scripts/runControlledVoiceTransformation.js",
    "interpret:product-page": "node --env-file=.env scripts/runProductPageInterpretation.js",
    "generation:fixture": "node scripts/buildGenerationFixture.js",
    "cms:read-product": "node --env-file=.env scripts/readWordPressAuthoritativeProduct.js",
    "cms:validate-authoritative-endpoint": "node --env-file=.env scripts/validateWordPressAuthoritativeEndpoint.js"
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  }
}
