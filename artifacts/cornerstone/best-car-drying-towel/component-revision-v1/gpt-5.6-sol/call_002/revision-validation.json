    "appearances": [
      {
        "concept_id": "gsm",
        "component_id": "01_hero_db1ccb26",
        "component_type": "hero",
        "classification": "brief_reference",
        "text": "I’ll show you how to narrow the choice to something practical for your vehicle instead of chasing whichever product has the biggest headline number."
      },
      {
        "concept_id": "gsm",
        "component_id": "02_quick_answer_eb07986e",
        "component_type": "quick_answer",
        "classification": "brief_reference",
        "text": "Construction, weave and GSM."
      },
      {
        "concept_id": "gsm",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "GSM in context"
      },
      {
        "concept_id": "gsm",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "GSM means grams per square metre and describes the weight of the fabric."
      },
      {
        "concept_id": "gsm",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "I would look at GSM alongside the rest of the specification rather than using it to declare one towel better, safer or faster."
      },
      {
        "concept_id": "gsm",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "brief_reference",
        "text": "Where the Street Kingz 1200 GSM towel fits"
      },
      {
        "concept_id": "gsm",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "product_specification",
        "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
      },
      {
        "concept_id": "dimensions",
        "component_id": "02_quick_answer_eb07986e",
        "component_type": "quick_answer",
        "classification": "brief_reference",
        "text": "Dimensions and edging."
      },
      {
        "concept_id": "dimensions",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Microfibre is a prominent car-drying option, and waffle weave is another format people search for, but the name alone does not establish which will perform better."
      },
      {
        "concept_id": "dimensions",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Dimensions"
      },
      {
        "concept_id": "dimensions",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Dimensions affect how much panel area a towel can cover and how easy it is to place and control."
      },
      {
        "concept_id": "dimensions",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "A large format may be useful across broad panels, but more size is not automatically better."
      },
      {
        "concept_id": "dimensions",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "substantial_explanation",
        "text": "A larger vehicle with broad panels may make a larger towel convenient, while a smaller car or tighter bodywork may favour something easier to position."
      },
      {
        "concept_id": "dimensions",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "brief_reference",
        "text": "A towel takes on extra weight as it collects water, and a large format can become harder to lift, reposition or wring."
      },
      {
        "concept_id": "dimensions",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "substantial_explanation",
        "text": "If you expect to wring the towel partway through, choose a format you can handle comfortably at that stage."
      },
      {
        "concept_id": "dimensions",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "substantial_explanation",
        "text": "Choose the format you can still control comfortably partway through the job."
      },
      {
        "concept_id": "dimensions",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "product_specification",
        "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
      },
      {
        "concept_id": "dimensions",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "substantial_explanation",
        "text": "Offer a low-pressure link to the product details so the reader can check the stated format and trade-off before deciding."
      },
      {
        "concept_id": "dimensions",
        "component_id": "10_conclusion_b18ab30e",
        "component_type": "conclusion",
        "classification": "substantial_explanation",
        "text": "The Street Kingz heavy-duty towel is worth considering if its large, dense format and handling trade-off suit you."
      },
      {
        "concept_id": "edging",
        "component_id": "02_quick_answer_eb07986e",
        "component_type": "quick_answer",
        "classification": "brief_reference",
        "text": "Dimensions and edging."
      },
      {
        "concept_id": "edging",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Edging"
      },
      {
        "concept_id": "edging",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Look at the edge finish as well as the main fabric."
      },
      {
        "concept_id": "edging",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Edging is a separate part of the towel’s construction, so it deserves its own check when you compare product descriptions."
      },
      {
        "concept_id": "edging",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "product_specification",
        "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
      },
      {
        "concept_id": "saturated_handling",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "substantial_explanation",
        "text": "Wet handling is where a good-looking specification can meet real-world inconvenience."
      },
      {
        "concept_id": "saturated_handling",
        "component_id": "05_rich_text_section_cfb857cc",
        "component_type": "rich_text_section",
        "classification": "substantial_explanation",
        "text": "The Street Kingz towel covered next is specifically described as becoming heavier when saturated, so that trade-off needs to suit you rather than surprise you."
      },
      {
        "concept_id": "saturated_handling",
        "component_id": "06_product_recommendation_55fb7dcb",
        "component_type": "product_recommendation",
        "classification": "substantial_explanation",
        "text": "My view is that it makes the most sense for someone who actively wants a large, dense towel and is comfortable handling the extra weight once it is saturated."
      },
      {
        "concept_id": "saturated_handling",
        "component_id": "07_rich_text_section_7c121c6a",
        "component_type": "rich_text_section",
        "classification": "brief_reference",
        "text": "Wring it only when it becomes saturated."
      },
      {
        "concept_id": "care",
        "component_id": "02_quick_answer_eb07986e",
        "component_type": "quick_answer",
        "classification": "brief_reference",
        "text": "Use and care instructions."
      },
      {
        "concept_id": "care",
        "component_id": "08_key_takeaway_db6e5d8e",
        "component_type": "key_takeaway",
        "classification": "substantial_explanation",
        "text": "How to wash, dry and care for the towel"
      },
      {
        "concept_id": "care",
        "component_id": "08_key_takeaway_db6e5d8e",
        "component_type": "key_takeaway",
        "classification": "substantial_explanation",
        "text": "For the Street Kingz towel, use a cold, gentle wash with suitable detergent, then let it air dry before putting it away clean and dry."
      },
      {
        "concept_id": "care",
        "component_id": "08_key_takeaway_db6e5d8e",
        "component_type": "key_takeaway",
        "classification": "substantial_explanation",
        "text": "Do not use fabric softener."
      },
      {
        "concept_id": "care",
        "component_id": "08_key_takeaway_db6e5d8e",
        "component_type": "key_takeaway",
        "classification": "substantial_explanation",
        "text": "Do not use bleach."
      },
      {
        "concept_id": "care",
        "component_id": "08_key_takeaway_db6e5d8e",
        "component_type": "key_takeaway",
        "classification": "substantial_explanation",
        "text": "Air dry rather than tumble dry."
      },
      {
        "concept_id": "care",
        "component_id": "09_faq_5dc1c294",
        "component_type": "faq",
        "classification": "faq_direct_answer",
        "text": "For the Street Kingz towel, that includes a cold gentle wash, no softener or bleach, and air drying."
      },
      {
        "concept_id": "construction",
        "component_id": "02_quick_answer_eb07986e",
        "component_type": "quick_answer",
        "classification": "substantial_explanation",
        "text": "Construction, weave and GSM."
      },
      {
        "concept_id": "construction",
        "component_id": "03_criteria_cards_44e50cdc",
        "component_type": "criteria_cards",
        "classification": "substantial_explanation",
        "text": "Construction and weave"
      },
      {
        "concept_id": "construction",
        "component_id": "03_criteria_cards_44e50cdc",
