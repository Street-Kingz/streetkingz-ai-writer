      "appearances": [
        {
          "concept_id": "gsm",
          "component_id": "01_hero_db1ccb26",
          "component_type": "hero",
          "classification": "brief_reference",
          "text": "I’ll help you narrow it down to something that suits your vehicle instead of chasing whichever product has the biggest headline number."
        },
        {
          "concept_id": "gsm",
          "component_id": "02_quick_answer_eb07986e",
          "component_type": "quick_answer",
          "classification": "brief_reference",
          "text": "Construction, weave and GSM."
        },
        {
          "concept_id": "gsm",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "GSM in context"
        },
        {
          "concept_id": "gsm",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "GSM stands for grams per square metre and tells you the weight of the fabric."
        },
        {
          "concept_id": "gsm",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "I’d check GSM alongside the rest of the specification instead of using one impressive number to call a towel better, safer or faster."
        },
        {
          "concept_id": "gsm",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "product_specification",
          "text": "Where the Street Kingz 1200 GSM towel fits"
        },
        {
          "concept_id": "gsm",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "product_specification",
          "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
        },
        {
          "concept_id": "dimensions",
          "component_id": "02_quick_answer_eb07986e",
          "component_type": "quick_answer",
          "classification": "brief_reference",
          "text": "Dimensions and edging."
        },
        {
          "concept_id": "dimensions",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Microfibre is a prominent car-drying option, and waffle weave is another format people look for, but the label alone won’t tell you which one will perform better."
        },
        {
          "concept_id": "dimensions",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Dimensions"
        },
        {
          "concept_id": "dimensions",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Dimensions tell you how much area the towel can cover and how easy it should be to place and control."
        },
        {
          "concept_id": "dimensions",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "A larger towel may be handy across broad panels, but bigger isn’t automatically better."
        },
        {
          "concept_id": "dimensions",
          "component_id": "05_rich_text_section_cfb857cc",
          "component_type": "rich_text_section",
          "classification": "substantial_explanation",
          "text": "A larger vehicle with broad panels may make a larger towel more convenient, while a smaller car or tighter bodywork may suit something easier to position."
        },
        {
          "concept_id": "dimensions",
          "component_id": "05_rich_text_section_cfb857cc",
          "component_type": "rich_text_section",
          "classification": "substantial_explanation",
          "text": "Choose a format you can still control comfortably partway through the job."
        },
        {
          "concept_id": "dimensions",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "product_specification",
          "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
        },
        {
          "concept_id": "edging",
          "component_id": "02_quick_answer_eb07986e",
          "component_type": "quick_answer",
          "classification": "brief_reference",
          "text": "Dimensions and edging."
        },
        {
          "concept_id": "edging",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Edging"
        },
        {
          "concept_id": "edging",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Check the edge finish as well as the main fabric."
        },
        {
          "concept_id": "edging",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "The edging is a separate part of the towel, so it deserves its own look when you compare product descriptions."
        },
        {
          "concept_id": "edging",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "product_specification",
          "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
        },
        {
          "concept_id": "saturated_handling",
          "component_id": "05_rich_text_section_cfb857cc",
          "component_type": "rich_text_section",
          "classification": "substantial_explanation",
          "text": "The Street Kingz towel covered next is specifically described as becoming heavier when saturated, so it’s a trade-off you should expect rather than discover halfway through the job."
        },
        {
          "concept_id": "saturated_handling",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "substantial_explanation",
          "text": "My view is that it makes the most sense if you actively want a large, dense towel and you’re comfortable with the extra weight once it’s saturated."
        },
        {
          "concept_id": "saturated_handling",
          "component_id": "07_rich_text_section_7c121c6a",
          "component_type": "rich_text_section",
          "classification": "brief_reference",
          "text": "Wring it only when it becomes saturated."
        },
        {
          "concept_id": "care",
          "component_id": "02_quick_answer_eb07986e",
          "component_type": "quick_answer",
          "classification": "brief_reference",
          "text": "Use and care instructions."
        },
        {
          "concept_id": "care",
          "component_id": "08_key_takeaway_db6e5d8e",
          "component_type": "key_takeaway",
          "classification": "substantial_explanation",
          "text": "How to wash, dry and care for the towel"
        },
        {
          "concept_id": "care",
          "component_id": "08_key_takeaway_db6e5d8e",
          "component_type": "key_takeaway",
          "classification": "substantial_explanation",
          "text": "For the Street Kingz towel, use a cold, gentle wash with suitable detergent, then let it air dry before putting it away clean and dry."
        },
        {
          "concept_id": "care",
          "component_id": "08_key_takeaway_db6e5d8e",
          "component_type": "key_takeaway",
          "classification": "substantial_explanation",
          "text": "Do not use fabric softener."
        },
        {
          "concept_id": "care",
          "component_id": "08_key_takeaway_db6e5d8e",
          "component_type": "key_takeaway",
          "classification": "substantial_explanation",
          "text": "Do not use bleach."
        },
        {
          "concept_id": "care",
          "component_id": "08_key_takeaway_db6e5d8e",
          "component_type": "key_takeaway",
          "classification": "substantial_explanation",
          "text": "Air dry rather than tumble dry."
        },
        {
          "concept_id": "construction",
          "component_id": "02_quick_answer_eb07986e",
          "component_type": "quick_answer",
          "classification": "brief_reference",
          "text": "Construction, weave and GSM."
        },
        {
          "concept_id": "construction",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Construction and weave"
        },
        {
          "concept_id": "construction",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Construction is how the towel is made, while weave is how its fibres are arranged."
        },
        {
          "concept_id": "construction",
          "component_id": "03_criteria_cards_44e50cdc",
          "component_type": "criteria_cards",
          "classification": "substantial_explanation",
          "text": "Microfibre is a prominent car-drying option, and waffle weave is another format people look for, but the label alone won’t tell you which one will perform better."
        },
        {
          "concept_id": "construction",
          "component_id": "06_product_recommendation_55fb7dcb",
          "component_type": "product_recommendation",
          "classification": "product_specification",
          "text": "It has a 1200 GSM dual-sided microfibre construction, measures 90 × 60 cm, uses soft microfibre edging and is listed as suitable for cars and larger vehicles."
        },
        {
          "concept_id": "construction",
          "component_id": "09_faq_5dc1c294",
          "component_type": "faq",
          "classification": "faq_direct_answer",
          "text": "A purpose-made microfibre drying towel is a sensible option, but I can’t honestly say every microfibre towel is better than every waffle-weave towel, chamois or other method."
        }
      ]
    }
