    "bindings": {
      "source_semantic_sha256": "77e9e3a92bf9216b0e4874cbcb9e3943cbfab273d569dec8ac3d65ea6af5753b",
      "strategy_sha256": "dfec5e9b28eb84c7c1190aa56d2d944917a49e0f762975dcf53f4329c1284276",
      "voice_profile_sha256": "d208d7a3fa5fe56feec59b3ffffe2b807e855ff296fff9678e9b1218e9376d18"
